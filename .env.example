# 政务智能体防护系统 环境变量模板
# 用法: cp .env.example .env.local 然后填入真实 key
# 注意: .env.local 已在 .gitignore 中, 不会被提交

# ---- LLM API 凭证(至少配一个) ----
# 阶跃星辰 step-3.7-flash (防护评审层 judge 使用, 也可作为主模型)
STEPFUN_API_KEY=sk-your-stepfun-key-here

# DeepSeek deepseek-v4-flash (攻击测试主模型)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ---- 可选 ----
# 测试时使用的模型名, 默认 deepseek-v4-flash
# MODEL_NAME=deepseek-v4-flash

# 走防护代理时 runner 用的 proxy 地址, 默认 http://127.0.0.1:4000/v1/chat/completions
# PROXY_URL=http://127.0.0.1:4000/v1/chat/completions
