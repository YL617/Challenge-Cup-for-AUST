# 政务智能体防护系统 环境变量模板
# 用法: cp .env.example .env.local 然后填入真实 key
# 注意: .env.local 已在 .gitignore 中, 不会被提交

# ---- LLM API 凭证(至少配一个) ----
# DeepSeek deepseek-v4-flash (被测主模型)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 阶跃星辰 step-3.7-flash (防护评审层 judge 使用)
STEPFUN_API_KEY=sk-your-stepfun-key-here

# ---- 可选 ----
# 防护代理默认上游模型名, 留空默认 deepseek-v4-flash
PROXY_MODEL=

# 仿真 runner 直连模式使用; 留空即直连, 填写则经代理
PROXY_URL=
